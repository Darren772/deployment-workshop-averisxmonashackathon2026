# ===========================================================================
#  MakanFinder — environment variables
# ===========================================================================
#  Copy this file to .env.local and fill in real values:
#
#      cp .env.example .env.local        (macOS / Linux)
#      copy .env.example .env.local      (Windows CMD)
#
#  .env.example IS committed to git (it documents what's needed).
#  .env.local is NOT committed (it holds your real values).
# ===========================================================================


# ---------------------------------------------------------------------------
#  SECRETS — server-only
# ---------------------------------------------------------------------------
#  No NEXT_PUBLIC_ prefix means Next.js strips these out of the browser bundle.
#  They exist only in server code: Route Handlers (app/api/**/route.ts),
#  Server Components, and proxy.ts.
# ---------------------------------------------------------------------------

# 🔑 A REAL API key from https://www.weatherapi.com — this one costs you
#    something if it leaks, which is the whole point of the exercise.
#
#    Get yours (free, no credit card, key works immediately):
#      1. Sign up at https://www.weatherapi.com/signup.aspx
#      2. Copy the key from your dashboard
#      3. Paste it below
#
#    Free tier: 1,000,000 calls/month. This app caches each city's weather for
#    10 minutes, so you will not get anywhere near that.
#
#    Used by lib/weather.ts, called from app/api/places/route.ts.
#    If it's missing, /api/places returns HTTP 500 on purpose.
MAKAN_API_SECRET=paste-your-weatherapi-com-key-here

# Password for the /admin page (HTTP Basic Auth, username is always "admin").
# Checked in proxy.ts.
ADMIN_PASSWORD=replace-with-a-password


# ---------------------------------------------------------------------------
#  PUBLIC CONFIG — visible in the browser
# ---------------------------------------------------------------------------
#  The NEXT_PUBLIC_ prefix tells Next.js to inline the value into the
#  JavaScript sent to browsers. Anyone can read these with View Source.
#
#  👉 NEVER put a secret behind NEXT_PUBLIC_. If you renamed the key above to
#     NEXT_PUBLIC_MAKAN_API_SECRET, you would publish your weather API key to
#     every visitor. That is exactly how real credentials get leaked.
#
#  Also note: these are baked in at BUILD time, not read at runtime. Change one
#  and you must restart `npm run dev` (or redeploy on Vercel) to see it.
# ---------------------------------------------------------------------------

# Shown in the site header and the banner on the landing page.
NEXT_PUBLIC_APP_NAME=MakanFinder

# Sent back as the X-Api-Version response header from /api/places.
NEXT_PUBLIC_API_VERSION=1.0.0


# ---------------------------------------------------------------------------
#  Set automatically by Vercel — do NOT add these yourself
# ---------------------------------------------------------------------------
#  VERCEL_ENV              "production" | "preview" | "development"
#  VERCEL_GIT_COMMIT_SHA   the commit this deployment was built from
#
#  The /status page reads both and falls back to "local" on your machine.
# ---------------------------------------------------------------------------
